# Environment Variables for Sports Betting Edge Toolkit
# Copy this to .env and fill in your values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Bookmaker Credentials (for authenticated scraping)
TIPSPORT_USERNAME=
TIPSPORT_PASSWORD=

FORTUNA_USERNAME=
FORTUNA_PASSWORD=

NIKE_USERNAME=
NIKE_PASSWORD=

DOXXBET_USERNAME=
DOXXBET_PASSWORD=

PINNACLE_USERNAME=
PINNACLE_PASSWORD=

BET365_USERNAME=
BET365_PASSWORD=

# VPN Configuration (for international books)
VPN_ENABLED=false
VPN_COUNTRY=UK

# Proxy Configuration (optional)
PROXY_ENABLED=false
PROXY_URL=

# Database
DATABASE_URL=sqlite:///data/betting_edge.db

# API Keys (for odds APIs if available)
ODDS_API_KEY=
BETFAIR_API_KEY=
BETFAIR_SESSION_TOKEN=
